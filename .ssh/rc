#!/bin/bash

# Point a stable path at a working forwarded agent socket so tmux and other
# long-lived processes can find the agent.
#
# Only re-point when the current target is unreachable. Every connection runs
# this file, including short-lived ones (scp, rsync, one-shot ssh), and those
# would otherwise claim the stable path and leave it dangling when they exit,
# even while a long-lived session's socket is still alive.
#
# ssh-add exit codes: 0 = agent has keys, 1 = reachable but empty, 2 = cannot
# connect. timeout returns 124 when the agent does not respond.
if [ -n "$SSH_AUTH_SOCK" ] && [ -S "$SSH_AUTH_SOCK" ]; then
    timeout 2s env SSH_AUTH_SOCK="$HOME/.ssh/ssh_auth_sock" \
        ssh-add -l >/dev/null 2>&1
    status=$?
    if [ "$status" -eq 2 ] || [ "$status" -eq 124 ]; then
        ln -sfn "$SSH_AUTH_SOCK" "$HOME/.ssh/ssh_auth_sock"
    fi
fi
