{
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(git add:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ban-bare-pip-python.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-github-mutations.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "zeus@ml-energy": true,
    "mlenergy-data@ml-energy": true
  },
  "extraKnownMarketplaces": {
    "ml-energy": {
      "source": {
        "source": "directory",
        "path": "/Users/jaywonchung/workspace/mlenergy/plugins"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "awaySummaryEnabled": false,
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "addCoauthoredBy": false,
  "trustedDirectories": [
    "/Users/jaywonchung"
  ]
}
