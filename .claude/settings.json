{
  "permissions": {
    "allow": [
      "Bash(~/.claude/scripts/fetch-reviews.sh*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ban-bare-pip-python.sh"
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "voiceEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "addCoauthoredBy": false,
  "trustedDirectories": [
    "/Users/jaywonchung"
  ]
}
