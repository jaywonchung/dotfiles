{
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(git add:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ban-bare-pip-python.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-github-mutations.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "'/Applications/Dockset.app/Contents/MacOS/Dockset' --claude-usage-statusline"
  },
  "enabledPlugins": {
    "mlenergy-data@ml-energy": true
  },
  "extraKnownMarketplaces": {
    "ml-energy": {
      "source": {
        "source": "github",
        "repo": "ml-energy/plugins"
      }
    }
  },
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "awaySummaryEnabled": false,
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "notifications_disabled",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "addCoauthoredBy": false,
  "trustedDirectories": [
    "/Users/jaywonchung"
  ]
}
